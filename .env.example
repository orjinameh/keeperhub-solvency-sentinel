# KeeperHub (create at app.keeperhub.com > Settings > API Keys > Organisation tab)
KEEPERHUB_API_KEY=kh_your_org_key_here
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# The address the sentinel protects (the org wallet behind your KeeperHub wallet integration).
# Leave empty to auto-resolve via the wallet integration on first run.
SENTINEL_USER=0x0000000000000000000000000000000000000000

# Position + policy
SENTINEL_CHAIN=84532            # Base Sepolia (Aave V3 testnet). Also: 11155111, 8453, 42161, 137, 1
SENTINEL_CRITICAL_HF=1.05       # act when health factor falls below this
SENTINEL_TARGET_HF=1.5          # restore health factor to at least this
SENTINEL_INTERVAL_SECONDS=60    # watch-mode cadence
SENTINEL_CONFIRM=1              # set to 0 to skip the interactive confirm before broadcasting
